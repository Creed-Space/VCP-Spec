{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vcp.creedspace.org/schemas/vcp-capability-handshake.schema.json",
  "title": "VCP Capability Negotiation Handshake",
  "description": "JSON Schema for VCP v3.1 capability negotiation messages: vcp-hello, vcp-ack, and vcp-error.",
  "$defs": {
    "semver_minor": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,8})\\.(?:0|[1-9][0-9]{0,8})$",
      "description": "Semver major.minor version string (e.g., '3.1')."
    },
    "extension_id": {
      "type": "string",
      "pattern": "^VCP-X-[A-Za-z][A-Za-z0-9-]*$",
      "description": "A VCP extension identifier (e.g., 'VCP-X-Personal').",
      "minLength": 7,
      "maxLength": 128
    },
    "vcp_hello": {
      "type": "object",
      "description": "Client-to-server handshake initiation.",
      "properties": {
        "type": {
          "const": "vcp-hello"
        },
        "version": {
          "$ref": "#/$defs/semver_minor",
          "description": "Highest VCP version the client supports."
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension_request"
          },
          "uniqueItems": true,
          "default": [],
          "description": "Extensions the client wishes to activate.",
          "maxItems": 256
        },
        "identity": {
          "type": [
            "string",
            "null"
          ],
          "description": "A VCP/I identity token, or null for anonymous access.",
          "maxLength": 2048
        },
        "min_version": {
          "$ref": "#/$defs/semver_minor",
          "default": "1.0",
          "description": "Lowest VCP version the client can operate with."
        },
        "client_id": {
          "type": "string",
          "maxLength": 256,
          "description": "Human-readable client identifier for diagnostics.",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "version"
      ],
      "additionalProperties": true
    },
    "core_features": {
      "type": "object",
      "description": "Server-wide core security and verification features.",
      "properties": {
        "encryption": {
          "type": "boolean",
          "description": "Context encryption at rest (Fernet symmetric)."
        },
        "injection_scanning": {
          "type": "boolean",
          "description": "Injection pattern detection (OWASP + VCP-specific)."
        },
        "revocation": {
          "type": "boolean",
          "description": "CRL and stapled proof infrastructure."
        },
        "audit_chain": {
          "type": "boolean",
          "description": "Tamper-evident SHA-256 hash chain."
        },
        "context_opacity": {
          "type": "boolean",
          "description": "Protection level abstraction layer."
        }
      },
      "required": [
        "encryption",
        "injection_scanning",
        "revocation",
        "audit_chain",
        "context_opacity"
      ],
      "additionalProperties": true
    },
    "extension_capabilities": {
      "type": "object",
      "description": "Per-extension capability advertisement. Keys are extension identifiers, values are extension-defined capability objects.",
      "patternProperties": {
        "^VCP-X-[A-Za-z][A-Za-z0-9-]*$": {
          "type": "object",
          "additionalProperties": true,
          "description": "Capability object defined by the extension's own specification."
        }
      },
      "additionalProperties": false,
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/extension_id"
      }
    },
    "vcp_ack": {
      "type": "object",
      "description": "Server-to-client handshake confirmation.",
      "properties": {
        "type": {
          "const": "vcp-ack"
        },
        "version": {
          "$ref": "#/$defs/semver_minor",
          "description": "The negotiated VCP version."
        },
        "supported": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension_id"
          },
          "uniqueItems": true,
          "description": "Extensions from the client's list that the server supports and activated.",
          "maxItems": 256
        },
        "unsupported": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension_id"
          },
          "uniqueItems": true,
          "description": "Extensions from the client's list that the server does not support.",
          "maxItems": 256
        },
        "capabilities": {
          "$ref": "#/$defs/extension_capabilities"
        },
        "core_features": {
          "$ref": "#/$defs/core_features"
        },
        "server_id": {
          "type": "string",
          "maxLength": 256,
          "description": "Human-readable server identifier for diagnostics.",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "maxLength": 128,
          "description": "Opaque session identifier for correlation.",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "version",
        "supported",
        "unsupported",
        "capabilities",
        "core_features"
      ],
      "additionalProperties": true
    },
    "error_code": {
      "type": "string",
      "enum": [
        "VERSION_UNSUPPORTED",
        "IDENTITY_REQUIRED",
        "IDENTITY_INVALID",
        "EXTENSION_CONFLICT",
        "RATE_LIMITED",
        "INTERNAL_ERROR"
      ],
      "description": "Machine-readable error code for handshake failures."
    },
    "vcp_error": {
      "type": "object",
      "description": "Server-to-client handshake failure.",
      "properties": {
        "type": {
          "const": "vcp-error"
        },
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "maxLength": 1024,
          "description": "Human-readable error description.",
          "minLength": 1
        },
        "supported_versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semver_minor"
          },
          "uniqueItems": true,
          "description": "Versions the server supports. MUST be present when code is VERSION_UNSUPPORTED.",
          "minItems": 1,
          "maxItems": 64
        },
        "retry_after": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Seconds the client should wait before retrying. Null means no retry expected."
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ],
      "if": {
        "properties": {
          "code": {
            "const": "VERSION_UNSUPPORTED"
          }
        }
      },
      "then": {
        "properties": {
          "supported_versions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/semver_minor"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "supported_versions"
        ]
      },
      "additionalProperties": true
    },
    "extension_request": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "A bounded requested extension string. Receivers ignore entries that do not match extension_id."
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/vcp_hello"
    },
    {
      "$ref": "#/$defs/vcp_ack"
    },
    {
      "$ref": "#/$defs/vcp_error"
    }
  ]
}
