{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creed.space/schemas/vcp/extensions/personal/v1.1.0",
  "title": "VCP-X-Personal Extension Schema",
  "description": "JSON Schema for VCP-X-Personal personal state signaling extension (VCP 3.1). Validates PersonalSignal, PersonalContext, DecayConfig, and GenerationPreferences.",

  "$defs": {
    "PersonalDimension": {
      "type": "string",
      "enum": ["cognitive_state", "emotional_tone", "energy_level", "perceived_urgency", "body_signals"],
      "description": "The five personal state dimensions in VCP 3.1."
    },

    "CognitiveStateValue": {
      "type": "string",
      "enum": ["focused", "distracted", "overloaded", "foggy", "reflective"],
      "description": "Valid categorical values for the cognitive_state dimension."
    },

    "EmotionalToneValue": {
      "type": "string",
      "enum": ["calm", "tense", "frustrated", "neutral", "uplifted"],
      "description": "Valid categorical values for the emotional_tone dimension."
    },

    "EnergyLevelValue": {
      "type": "string",
      "enum": ["rested", "low_energy", "fatigued", "wired", "depleted"],
      "description": "Valid categorical values for the energy_level dimension."
    },

    "PerceivedUrgencyValue": {
      "type": "string",
      "enum": ["unhurried", "time_aware", "pressured", "critical"],
      "description": "Valid categorical values for the perceived_urgency dimension."
    },

    "BodySignalsValue": {
      "type": "string",
      "enum": ["neutral", "discomfort", "pain", "unwell", "recovering"],
      "description": "Valid categorical values for the body_signals dimension."
    },

    "SignalSource": {
      "type": "string",
      "enum": ["declared", "inferred", "inferred_local", "measured", "elicitation", "preset", "decayed"],
      "description": "How the personal signal was obtained. 'measured' indicates instrument-mediated observation (IoT, wearable, biometric). See spec §2.3 for the inferred_local/measured distinction."
    },

    "DecayCurve": {
      "type": "string",
      "enum": ["exponential", "linear", "step"],
      "description": "Shape of the decay function applied to signal intensity."
    },

    "LifecycleState": {
      "type": "string",
      "enum": ["set", "active", "decaying", "stale", "expired"],
      "description": "Current lifecycle state of a personal dimension signal."
    },

    "PersonalSignal": {
      "type": "object",
      "description": "A single personal state signal with categorical value and intensity.",
      "required": ["category"],
      "properties": {
        "category": {
          "type": "string",
          "description": "Categorical value from the parent dimension's enum (e.g., 'focused', 'calm', 'rested').",
          "oneOf": [
            { "$ref": "#/$defs/CognitiveStateValue" },
            { "$ref": "#/$defs/EmotionalToneValue" },
            { "$ref": "#/$defs/EnergyLevelValue" },
            { "$ref": "#/$defs/PerceivedUrgencyValue" },
            { "$ref": "#/$defs/BodySignalsValue" }
          ]
        },
        "intensity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 3,
          "description": "Signal intensity on a 1-5 scale (1=minimal, 5=strong)."
        },
        "source": {
          "$ref": "#/$defs/SignalSource",
          "default": "declared",
          "description": "How this signal was obtained."
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 1.0,
          "description": "Confidence in the signal's accuracy (0.0=none, 1.0=certain)."
        },
        "declared_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "default": null,
          "description": "ISO 8601 timestamp of when the signal was declared. Used for decay calculation."
        },
        "extended": {
          "type": ["string", "null"],
          "maxLength": 256,
          "default": null,
          "description": "Optional sub-signal for implementer-defined refinement (e.g., 'migraine', 'hunger')."
        }
      },
      "additionalProperties": false
    },

    "PersonalContext": {
      "type": "object",
      "description": "Container for all five personal state dimensions. Each dimension is independently nullable.",
      "properties": {
        "cognitive_state": {
          "oneOf": [
            { "$ref": "#/$defs/CognitiveStateSignal" },
            { "type": "null" }
          ],
          "default": null,
          "description": "Mental clarity and focus signal."
        },
        "emotional_tone": {
          "oneOf": [
            { "$ref": "#/$defs/EmotionalToneSignal" },
            { "type": "null" }
          ],
          "default": null,
          "description": "Emotional register signal."
        },
        "energy_level": {
          "oneOf": [
            { "$ref": "#/$defs/EnergyLevelSignal" },
            { "type": "null" }
          ],
          "default": null,
          "description": "Physical and mental energy signal."
        },
        "perceived_urgency": {
          "oneOf": [
            { "$ref": "#/$defs/PerceivedUrgencySignal" },
            { "type": "null" }
          ],
          "default": null,
          "description": "Time pressure perception signal."
        },
        "body_signals": {
          "oneOf": [
            { "$ref": "#/$defs/BodySignalsSignal" },
            { "type": "null" }
          ],
          "default": null,
          "description": "Physical comfort and wellbeing signal."
        }
      },
      "additionalProperties": false
    },

    "CognitiveStateSignal": {
      "type": "object",
      "description": "PersonalSignal constrained to cognitive_state dimension values.",
      "required": ["category"],
      "properties": {
        "category": { "$ref": "#/$defs/CognitiveStateValue" },
        "intensity": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
        "source": { "$ref": "#/$defs/SignalSource", "default": "declared" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 1.0 },
        "declared_at": { "type": ["string", "null"], "format": "date-time", "default": null },
        "extended": { "type": ["string", "null"], "maxLength": 256, "default": null }
      },
      "additionalProperties": false
    },

    "EmotionalToneSignal": {
      "type": "object",
      "description": "PersonalSignal constrained to emotional_tone dimension values.",
      "required": ["category"],
      "properties": {
        "category": { "$ref": "#/$defs/EmotionalToneValue" },
        "intensity": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
        "source": { "$ref": "#/$defs/SignalSource", "default": "declared" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 1.0 },
        "declared_at": { "type": ["string", "null"], "format": "date-time", "default": null },
        "extended": { "type": ["string", "null"], "maxLength": 256, "default": null }
      },
      "additionalProperties": false
    },

    "EnergyLevelSignal": {
      "type": "object",
      "description": "PersonalSignal constrained to energy_level dimension values.",
      "required": ["category"],
      "properties": {
        "category": { "$ref": "#/$defs/EnergyLevelValue" },
        "intensity": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
        "source": { "$ref": "#/$defs/SignalSource", "default": "declared" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 1.0 },
        "declared_at": { "type": ["string", "null"], "format": "date-time", "default": null },
        "extended": { "type": ["string", "null"], "maxLength": 256, "default": null }
      },
      "additionalProperties": false
    },

    "PerceivedUrgencySignal": {
      "type": "object",
      "description": "PersonalSignal constrained to perceived_urgency dimension values.",
      "required": ["category"],
      "properties": {
        "category": { "$ref": "#/$defs/PerceivedUrgencyValue" },
        "intensity": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
        "source": { "$ref": "#/$defs/SignalSource", "default": "declared" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 1.0 },
        "declared_at": { "type": ["string", "null"], "format": "date-time", "default": null },
        "extended": { "type": ["string", "null"], "maxLength": 256, "default": null }
      },
      "additionalProperties": false
    },

    "BodySignalsSignal": {
      "type": "object",
      "description": "PersonalSignal constrained to body_signals dimension values.",
      "required": ["category"],
      "properties": {
        "category": { "$ref": "#/$defs/BodySignalsValue" },
        "intensity": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
        "source": { "$ref": "#/$defs/SignalSource", "default": "declared" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 1.0 },
        "declared_at": { "type": ["string", "null"], "format": "date-time", "default": null },
        "extended": { "type": ["string", "null"], "maxLength": 256, "default": null }
      },
      "additionalProperties": false
    },

    "StepThreshold": {
      "type": "object",
      "description": "A discrete intensity step for step-curve decay.",
      "required": ["after_seconds", "intensity"],
      "properties": {
        "after_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds after declaration when this step activates."
        },
        "intensity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Intensity value at this step."
        }
      },
      "additionalProperties": false
    },

    "DecayConfig": {
      "type": "object",
      "description": "Configuration for signal decay behavior. Controls how signal intensity degrades over time.",
      "required": ["half_life_seconds"],
      "properties": {
        "half_life_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Time in seconds for intensity to reach 50% of the range between declared and baseline."
        },
        "baseline": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 1,
          "description": "Floor intensity value. Signal clears when it reaches this value."
        },
        "reset_on_engagement": {
          "type": "boolean",
          "default": false,
          "description": "If true, user activity resets the decay timer."
        },
        "curve": {
          "$ref": "#/$defs/DecayCurve",
          "default": "exponential",
          "description": "Shape of the decay function."
        },
        "stale_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.3,
          "description": "Fraction of declared-to-baseline range below which the signal is considered stale."
        },
        "fresh_window_seconds": {
          "type": "number",
          "minimum": 0,
          "default": 60,
          "description": "Seconds after declaration during which the signal remains ACTIVE without decay."
        },
        "pinned": {
          "type": "boolean",
          "default": false,
          "description": "If true, the signal never decays."
        },
        "full_decay_seconds": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "default": null,
          "description": "For LINEAR curve: total seconds from declared intensity to baseline."
        },
        "step_thresholds": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/StepThreshold" },
          "default": null,
          "description": "For STEP curve: ordered list of (after_seconds, intensity) pairs."
        }
      },
      "additionalProperties": false
    },

    "GenerationPreferences": {
      "type": "object",
      "description": "User-steerable response style parameters (Priori-style sliders). All fields nullable; null means no preference.",
      "properties": {
        "depth": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5,
          "default": null,
          "description": "Response depth: 1=brief, 5=detailed."
        },
        "formality": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5,
          "default": null,
          "description": "Response formality: 1=casual, 5=formal."
        },
        "directness": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5,
          "default": null,
          "description": "Response directness: 1=elaborated, 5=concise."
        },
        "technical_level": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5,
          "default": null,
          "description": "Technical level: 1=simple, 5=expert."
        }
      },
      "additionalProperties": false
    }
  },

  "type": "object",
  "properties": {
    "personal": {
      "oneOf": [
        { "$ref": "#/$defs/PersonalContext" },
        { "type": "null" }
      ],
      "description": "Personal state context (Layer 3)."
    },
    "generation_prefs": {
      "oneOf": [
        { "$ref": "#/$defs/GenerationPreferences" },
        { "type": "null" }
      ],
      "description": "User-steerable generation preferences (Layer 4)."
    },
    "preset_id": {
      "type": ["string", "null"],
      "description": "ID of the activated preset profile, if any."
    }
  },
  "additionalProperties": true
}
