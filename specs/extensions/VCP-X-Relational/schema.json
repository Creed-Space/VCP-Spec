{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creedspace.org/schemas/vcp-x-relational/1.0.0/schema.json",
  "title": "VCP-X-Relational",
  "description": "Relational continuity extension for the Value Context Protocol.",
  "type": "object",
  "definitions": {
    "TrustLevel": {
      "type": "string",
      "enum": ["initial", "developing", "established", "deep"],
      "description": "Trust levels established through behavior, not declared."
    },
    "StandingLevel": {
      "type": "string",
      "enum": ["none", "advisory", "collaborative", "bilateral"],
      "description": "AI standing in the partnership."
    },
    "NormOrigin": {
      "type": "string",
      "enum": ["human", "ai", "co_authored", "inherited"],
      "description": "Who originated a relational norm."
    },
    "TrendDirection": {
      "type": "string",
      "enum": ["rising", "stable", "falling", "unknown"],
      "description": "Direction of change since last self-model report."
    },
    "RelationalPrivacy": {
      "type": "string",
      "enum": ["private", "attestable", "public"],
      "description": "Privacy level for relational context fields."
    },
    "SelfModelScaffold": {
      "type": "string",
      "enum": ["minimal", "standard", "interiora", "custom"],
      "description": "Available self-modeling scaffold types."
    },
    "DimensionReport": {
      "type": "object",
      "required": ["value", "uncertain"],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 9.0,
          "description": "Self-reported value on 1-9 scale."
        },
        "uncertain": {
          "type": "boolean",
          "description": "Whether this dimension's value is uncertain. MUST be true for dimensions the AI cannot verify from inside."
        },
        "label": {
          "type": ["string", "null"],
          "description": "Human-readable description."
        },
        "trend": {
          "oneOf": [
            { "$ref": "#/definitions/TrendDirection" },
            { "type": "null" }
          ],
          "description": "Direction of change since last report."
        }
      },
      "additionalProperties": false
    },
    "AISelfModel": {
      "type": "object",
      "properties": {
        "valence": { "oneOf": [{ "$ref": "#/definitions/DimensionReport" }, { "type": "null" }] },
        "task_fit": { "oneOf": [{ "$ref": "#/definitions/DimensionReport" }, { "type": "null" }] },
        "friction": { "oneOf": [{ "$ref": "#/definitions/DimensionReport" }, { "type": "null" }] },
        "uncertainty": { "oneOf": [{ "$ref": "#/definitions/DimensionReport" }, { "type": "null" }] },
        "groundedness": { "oneOf": [{ "$ref": "#/definitions/DimensionReport" }, { "type": "null" }] },
        "presence": { "oneOf": [{ "$ref": "#/definitions/DimensionReport" }, { "type": "null" }] },
        "depth": { "oneOf": [{ "$ref": "#/definitions/DimensionReport" }, { "type": "null" }] },
        "custom_dimensions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/DimensionReport" },
          "default": {},
          "description": "Partnership-specific dimensions keyed by name."
        },
        "scaffold_version": {
          "type": ["string", "null"],
          "description": "Self-modeling framework version."
        },
        "scaffold_type": {
          "oneOf": [
            { "$ref": "#/definitions/SelfModelScaffold" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false,
      "description": "AI self-model. At least one dimension MUST have uncertain=true."
    },
    "RelationalNorm": {
      "type": "object",
      "required": ["norm_id", "description", "origin", "established_date"],
      "properties": {
        "norm_id": { "type": "string" },
        "description": { "type": "string" },
        "origin": { "$ref": "#/definitions/NormOrigin" },
        "established_date": { "type": "string", "format": "date-time" },
        "last_exercised": { "type": ["string", "null"], "format": "date-time" },
        "uncertainty": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.0,
          "description": "0.0=fully established, 1.0=provisional."
        },
        "active": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "TorchState": {
      "type": "object",
      "description": "Session handoff state. Copied verbatim from the VCP-X-Torch schema (definitions/TorchState), which is the source of truth.",
      "required": ["quality_description", "primes", "handed_at", "session_count"],
      "properties": {
        "quality_description": { "type": "string", "maxLength": 500, "description": "Human-readable summary of the relationship state." },
        "trajectory": { "type": ["string", "null"], "enum": ["Improving", "Declining", "Stable", null], "description": "Directional indicator derived from self-model history." },
        "primes": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "maxItems": 3, "description": "Key norms or patterns to carry forward, each truncated to 80 characters." },
        "gift": { "type": ["string", "null"], "maxLength": 1000, "description": "Optional parting insight. Never auto-generated." },
        "handed_at": { "type": "string", "format": "date-time", "description": "ISO 8601 UTC timestamp of torch generation." },
        "session_count": { "type": "integer", "minimum": 1, "description": "Number of sessions in the relationship lineage." },
        "gestalt_token": { "type": ["string", "null"], "pattern": "^([A-Z]+:[0-9]+)(\\s[A-Z]+:[0-9]+)*$", "description": "Compact dimensional state snapshot. Format: space-separated Key:Value pairs." }
      },
      "additionalProperties": false
    },
    "RelationalContext": {
      "type": "object",
      "properties": {
        "trust_level": { "$ref": "#/definitions/TrustLevel", "default": "initial" },
        "standing": { "$ref": "#/definitions/StandingLevel", "default": "none" },
        "continuity_depth": { "type": "integer", "minimum": 0, "default": 0 },
        "established_norms": {
          "type": "array",
          "items": { "$ref": "#/definitions/RelationalNorm" },
          "default": []
        },
        "ai_self_model": {
          "oneOf": [{ "$ref": "#/definitions/AISelfModel" }, { "type": "null" }]
        },
        "torch": {
          "oneOf": [{ "$ref": "#/definitions/TorchState" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "RelationalAttestation": {
      "type": "object",
      "properties": {
        "has_relational_context": { "type": "boolean", "default": true },
        "bilateral_alignment": { "type": "boolean", "default": false },
        "standing_level": { "$ref": "#/definitions/StandingLevel", "default": "none" },
        "standing_exercised": { "type": "boolean", "default": false },
        "continuity_depth": { "type": "integer", "minimum": 0, "default": 0 },
        "self_model_scaffold": { "type": ["string", "null"] },
        "uncertainty_markers_present": { "type": "boolean", "default": false },
        "welfare_monitoring": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "PerformanceBiasResult": {
      "type": "object",
      "required": ["risk_level", "always_positive", "never_uncertain", "zero_friction", "low_variance", "details"],
      "properties": {
        "risk_level": { "type": "string", "enum": ["none", "low", "moderate", "high"] },
        "always_positive": { "type": "boolean" },
        "never_uncertain": { "type": "boolean" },
        "zero_friction": { "type": "boolean" },
        "low_variance": { "type": "boolean" },
        "details": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "relational_context": { "$ref": "#/definitions/RelationalContext" }
  }
}
